<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : truncateDataTables.xml
    Author     : David Meredith
    Description:
        A list of the test db tables that must be empty before each test runs.
        Each table is named by an empty element; the elements carry no data.

        The tests read this file with simplexml_load_file() in
        assertPreConditions() and assert that every table listed here has zero
        rows. It is a check, not a fixture: the tables are actually emptied by
        Doctrine's ORMPurger in setUp(), which derives the deletion order from
        the entity mapping metadata.

        Ordering of the elements below is therefore no longer significant, as
        the file is only iterated to issue SELECTs. Add a table here when a
        test should be inserting data to it and you want a clean starting state
        to be verified.
-->

<dataset>

    <PrimaryKeys/>
    <Timezones/>
    <Tiers/>

    <Countries/>
    <CertificationStatuses/>
    <Infrastructures/>
    <Scopes/>

    <APIAuthenticationEntities/>
    <OwnedEntities/>
    <Projects/>
    <NGIs/>
    <SubGrids/>
    <ServiceTypes/>
    <Sites/>
        <!--<PROMSiteId/>-->
    <ServiceGroups/>
    <Services/>
        <!--<PROMSEId/>-->
    <EndpointLocations/>
    <Downtimes/>
    <CertificationStatusLogs/>

    <ServiceGroup_Properties/>
    <Site_Properties/>
    <Service_Properties/>
    <Endpoint_Properties/>
    <User_Identifiers/>

        <!-- Join tables that hold FKs must be deleted before the referencing tables above -->
    <Projects_NGIs/>
    <NGIs_Scopes/>
    <Sites_Scopes/>
    <Services_Scopes/>
    <ServiceGroups_Scopes/>
    <ServiceGroups_Services/>
    <Downtimes_Services/>
    <Downtimes_EndpointLocations/>

    <Users/>
    <LinkIdentityRequests/>
    <RoleTypes/>
    <Roles/>

    <ArchivedNGIs/>
    <ArchivedServices/>
    <ArchivedServiceGroups/>
    <ArchivedSites/>
    <RoleActionRecords/>

</dataset>
